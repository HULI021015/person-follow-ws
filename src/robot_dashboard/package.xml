<?xml version="1.0"?>
<package format="3">
  <name>robot_dashboard</name>
  <version>1.0.0</version>
  <description>Local web dashboard for person following and Piper grasping.</description>
  <maintainer email="zheng@example.com">zheng</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>piper_description</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
