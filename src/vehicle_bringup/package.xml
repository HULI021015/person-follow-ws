<?xml version="1.0"?>
<package format="3">
  <name>vehicle_bringup</name>
  <version>1.0.0</version>
  <description>Convert ROS 2 Twist commands to the YK CAN115 chassis SDK.</description>
  <maintainer email="maintainer@example.com">person_follow_ws</maintainer>
  <license>Apache-2.0</license>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <exec_depend>yk_can_sdk</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>

